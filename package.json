{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/ scripts/",
        "format:check": "prettier --check resources/ scripts/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "vue-tsc --noEmit",
        "bundle:check": "node scripts/check-bundle-size.mjs",
        "bundle:test": "node --test scripts/*.test.mjs",
        "a11y": "playwright test --config=tests/a11y/playwright.config.ts"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.9.1",
        "@lucide/vue": "^1.52.0",
        "@tebexio/tebex.js": "^1.11.1",
        "@tiptap/core": "^3.31.4",
        "@tiptap/extension-mention": "^3.31.4",
        "@tiptap/extension-text-style": "^3.31.4",
        "@tiptap/extensions": "^3.31.4",
        "@tiptap/pm": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "@tiptap/suggestion": "^3.32.0",
        "@tiptap/vue-3": "^3.31.4",
        "@unovis/ts": "^1.7.1",
        "@unovis/vue": "^1.7.1",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.23",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-vue": "^8.6.0",
        "laravel-echo": "^2.6.1",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tippy.js": "^6.3.7",
        "vue": "^3.5.44",
        "vue-sonner": "^2.0.9",
        "ziggy-js": "^2.6.5"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@inertiajs/vite": "^3.9.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "fontaine": "^0.8.2",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.30.0"
    }
