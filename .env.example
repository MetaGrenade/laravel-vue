APP_NAME=MetaForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Generate https:// URLs behind a TLS-terminating proxy or load balancer
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Comma-separated interface languages (see config/i18n.php and docs/i18n.md)
APP_SUPPORTED_LOCALES=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=pusher
BROADCAST_FORCE_LOG=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=https
PUSHER_FORCE_TLS=true
PUSHER_APP_CLUSTER=mt1
PUSHER_VERIFY_SSL=true
# PUSHER_CA_BUNDLE=/path/to/cacert.pem
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# How emails look (docs/email.md): the colour of buttons and links, the address of a logo image (the first letter of the name in a
# badge if there is none) and a line under every email, such as a company name and address.
MAIL_BRAND_COLOR="#4f46e5"
MAIL_LOGO_URL=
MAIL_FOOTER=

# The "Get started" checklist on a new customer's dashboard (docs/onboarding.md): whether it is shown, and for how many days.
ONBOARDING_ENABLED=true
ONBOARDING_DAYS=30

# Where a member can ask about a warning or a ban: an email address or a web address (docs/moderation.md). Empty says nothing about asking.
MODERATION_CONTACT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/oauth/google/callback"

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/oauth/discord/callback"

# Discord companion (metagrenade/metaforge-discord) — bot, role sync, notifications
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_APPLICATION_ID=
DISCORD_BOT_SHARED_SECRET=
DISCORD_WEBHOOK_URL=
DISCORD_ROLE_SYNC_ENABLED=true
DISCORD_PRESERVE_UNMAPPED_ROLES=true
DISCORD_API_BASE=https://discord.com/api/v10
DISCORD_STALE_SYNC_HOURS=24
DISCORD_SCHEDULE_STALE_SYNC=true
DISCORD_ADMIN_ROUTE_PREFIX=discord/admin
DISCORD_USER_ROUTE_PREFIX=discord/user

STEAM_REDIRECT_URI="${APP_URL}/auth/oauth/steam/callback"
STEAM_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_BROADCAST_DRIVER="${BROADCAST_CONNECTION}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_FORCE_TLS="${PUSHER_FORCE_TLS}"

# Laravel Sanctum Configuration
# List of domains (comma-separated) that should receive stateful API authentication cookies.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,::1

# (Optional) Name of the CSRF cookie that Sanctum will use.
SANCTUM_CSRF_COOKIE=CSRF-TOKEN

# Search. database uses LIKE; meilisearch uses Scout indexes (see docs/search-index.md).
# When meilisearch is unreachable, search falls back to database for CIRCUIT_SECONDS.
# MEILISEARCH_KEY is a server-side key limited to what the app needs (see "Keys" in docs/search-index.md), not the master key,
# and it is never sent to the browser.
# SCOUT_QUEUE=true indexes on the queue, so saving a post while Meilisearch is down still works (a worker must be running).
# SEARCH_HEALTH_TIMEOUT is how many seconds the ACP health card and metaforge:search:health wait for Meilisearch.
SEARCH_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SEARCH_MEILISEARCH_CIRCUIT_SECONDS=60
SCOUT_QUEUE=false
SEARCH_HEALTH_TIMEOUT=3

# Search Analytics
SEARCH_QUERY_RETENTION_DAYS=90
SEARCH_QUERY_AGGREGATION_WINDOW_DAYS=30
SEARCH_TOP_QUERIES_LIMIT=5
SEARCH_TOP_ZERO_QUERIES_LIMIT=5
SEARCH_QUERY_MIN_LENGTH=2

# Stripe Billing
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLI_WEBHOOK_SECRET=
# Seconds a Stripe webhook signature may be old or ahead. 0 accepts any time.
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_PRICE_STARTER=price_starter
STRIPE_PRICE_PRO=price_pro
BILLING_SUBSCRIPTION_NAME=default
BILLING_INVOICES_PER_PAGE=25
# The "Manage billing in Stripe" button. Save the portal's settings in the Stripe Dashboard first (docs/billing.md#customer-portal).
BILLING_PORTAL_ENABLED=true
STRIPE_PORTAL_CONFIGURATION=
# Metered usage (docs/usage.md). Empty free allowance: accounts with no plan are counted, not limited. Overage: block or allow.
BILLING_API_FREE_ALLOWANCE=
BILLING_API_OVERAGE=block
BILLING_USAGE_RETENTION_MONTHS=13

# API keys people make for themselves (Settings -> API keys, see docs/api-keys.md)
API_KEYS_MAX=10
API_KEYS_ALLOW_NO_EXPIRY=true

# What a key made by signing in over the API (POST /api/v1/auth/token) gets when the request does not say:
# a comma separated list of scopes (* for all of them), and how many days it lasts (empty or 0: no end, where allowed)
API_SIGN_IN_SCOPES=profile:read
API_SIGN_IN_EXPIRY_DAYS=90

# How many days the admin audit log is kept (docs/audit-log.md): 0 keeps it for ever
AUDIT_RETENTION_DAYS=0

# Shop checkout (see docs/commerce.md). Needs STRIPE_* above, a queue worker and the scheduler.
COMMERCE_CURRENCY=USD
COMMERCE_PROVIDER=stripe
COMMERCE_GUEST_CHECKOUT=true
COMMERCE_PAYMENT_WINDOW=60
COMMERCE_ORDER_PREFIX=MF
# Tracked stock at or below this is flagged as low in the ACP
COMMERCE_LOW_STOCK_THRESHOLD=5
# Product pictures: the disk must be served by the web ("public" needs `php artisan storage:link`)
COMMERCE_IMAGE_DISK=public
# Largest picture accepted, in pixels (width x height); 16000000 is a 4000 x 4000 photo
COMMERCE_IMAGE_MAX_PIXELS=16000000
# Digital downloads: files are kept on a private disk and handed out only through the order page.
COMMERCE_DOWNLOAD_DISK=local
COMMERCE_DOWNLOAD_MAX_KB=102400
COMMERCE_DOWNLOAD_LIMIT=10
COMMERCE_DOWNLOAD_EXPIRY_DAYS=0
COMMERCE_DOWNLOAD_LINK_MINUTES=30
# Wishlists: most products one customer can save
COMMERCE_WISHLIST_MAX=200
# Product reviews: who can write one, and which ones wait for staff to publish them (all, unverified or none)
COMMERCE_REVIEWS=true
COMMERCE_REVIEWS_REQUIRE_PURCHASE=false
COMMERCE_REVIEWS_APPROVAL=unverified
# Gift cards: issued by staff, spent at checkout (set false to hide the box at checkout)
COMMERCE_GIFT_CARDS=true

# Tebex (see docs/tebex.md): the store's keys from Developers -> API Keys in the Tebex panel. The private key is
# server-only and never shown. The catalogue is refreshed by the scheduler every N minutes (0 = never).
TEBEX_PUBLIC_TOKEN=
TEBEX_PRIVATE_KEY=
TEBEX_SYNC_EVERY_MINUTES=60
# The secret of the webhook endpoint added in the Tebex panel (Developers -> Webhooks -> Endpoints), pointed at
# /webhooks/tebex. Without it an order paid through Tebex is never marked paid, so Tebex is not offered as ready.
# Tebex sends only from two addresses; set the check to false only if a proxy hides the sender's address.
TEBEX_WEBHOOK_SECRET=
TEBEX_WEBHOOK_CHECK_IP=true
# Where the buyer pays: redirect (Tebex's own page, the default), popup or inline (Tebex.js on the shop's own page).
# The embedded modes let Tebex's frame in through the content security policy.
TEBEX_CHECKOUT_MODE=redirect

# EXPERIMENTAL. Sell the shop's own products (the ones that need no shipping) through Tebex's Checkout API instead of Tebex's
# packages. Needs Tebex's approval (their compliance team; not given to FiveM or RedM creators) and the PROJECT ID and private
# key from the Tebex panel (Developers -> API Keys). COMMERCE_CURRENCY must be the store's currency. See docs/tebex.md.
TEBEX_CHECKOUT_API_ENABLED=false
TEBEX_PROJECT_ID=

# Server-side rendering (run `npm run build:ssr` and `php artisan inertia:start-ssr`)
INERTIA_SSR_ENABLED=false

# SEO (indexing defaults to on in production only)
SEO_SITE_NAME="${APP_NAME}"
SEO_DESCRIPTION=
SEO_IMAGE=
SEO_TWITTER_HANDLE=
#SEO_INDEXING=true

# Security headers (see config/security.php)
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI=
#SECURITY_HSTS=true
#SECURITY_HSTS_SUBDOMAINS=false
# Where a vulnerability is reported. Published at /.well-known/security.txt.
#SECURITY_CONTACT_URI=https://github.com/MetaGrenade/laravel-vue/security/advisories/new
#SECURITY_POLICY_URL=https://github.com/MetaGrenade/laravel-vue/security/policy

# Private disk for support-ticket attachments (never a publicly served disk)
SUPPORT_ATTACHMENT_DISK=local
