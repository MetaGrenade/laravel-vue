{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "A Laravel + Inertia + Vue boilerplate for SaaS products and large community websites.",
    "keywords": [
        "laravel",
        "inertia",
        "vue",
        "saas",
        "boilerplate",
        "community"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dompdf/dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.9",
        "laravel/tinker": "^3.0",
        "meilisearch/meilisearch-php": "^1.17",
        "metagrenade/metaforge-discord": "dev-main",
        "pusher/pusher-php-server": "^7.3",
        "spatie/laravel-permission": "^8.0",
        "symfony/html-sanitizer": "^8.1",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.4",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.50",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#86efac,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --queue=default,mail --tries=1\" \"php artisan schedule:work\" \"npm run dev\" --names='server,queue,scheduler,vite'"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#86efac,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --queue=default,mail --tries=1\" \"php artisan schedule:work\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,scheduler,logs,ssr"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=2G --no-progress"
        ],
        "analyse:baseline": [
            "vendor/bin/phpstan analyse --memory-limit=2G --no-progress --generate-baseline phpstan-baseline.neon --allow-empty-baseline"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "suggest": {
        "ext-gd": "Needed to process product images (with WebP support).",
        "ext-exif": "Lets product photos taken sideways be turned the right way up."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "metagrenade/metaforge-discord",
                "version": "dev-main",
                "type": "library",
                "license": "MIT",
                "source": {
                    "url": "https://github.com/MetaGrenade/MetaForge-DiscordBot.git",
                    "type": "git",
                    "reference": "main"
                },
                "require": {
                    "php": "^8.4",
                    "illuminate/contracts": "^13.0",
                    "illuminate/http": "^13.0",
                    "illuminate/notifications": "^13.0",
                    "illuminate/routing": "^13.0",
                    "illuminate/support": "^13.0",
                    "spatie/laravel-permission": "^8.0"
                },
                "autoload": {
                    "psr-4": {
                        "MetaForge\\Discord\\": "laravel/src/"
                    }
                },
                "extra": {
                    "laravel": {
                        "providers": [
                            "MetaForge\\Discord\\DiscordServiceProvider"
                        ]
                    }
                }
            }
        }
    ]
}
